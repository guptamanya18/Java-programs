
class Solution {
    int countPartitions(int[] arr, int d) {
        // code here
        int n=arr.length;
        int sum=0;
        for(int i=0;i<n;i++)
        {
            sum+=arr[i];
        }
        
        if((sum+d)%2!=0 || sum<d)
        {
            return 0;
        }
        
        int val=(d+sum)/2;
        
        return subsetCnt(arr,val);
    }
    
    int subsetCnt(int[]arr,int sum)
    {
        int n=arr.length;
        int[][]t=new int[n+1][sum+1];
        for(int i=0;i<n+1;i++)
        {
            t[i][0]=1;
        }
        for(int j=1;j<sum+1;j++)
        {
            t[0][j]=0;
        }
        
        for(int i=1;i<n+1;i++)
        {
            for(int j=0;j<sum+1;j++)
            {
                if(arr[i-1]<=j)
                {
                    t[i][j]=t[i-1][j-arr[i-1]]+t[i-1][j];
                }
                else
                {
                    t[i][j]=t[i-1][j];
                }
            }
        }
        return t[n][sum];
    }
}
