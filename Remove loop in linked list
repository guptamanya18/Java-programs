/*
class Node
{
    int data;
    Node next;
}
*/

class Solution {
    // Function to remove a loop in the linked list.
    public static void removeLoop(Node head) {
        // code here
        Node fast=head;
        Node slow=head;
        Node prev=null;
        Node temp=head;
        while(fast!=null && fast.next!=null)
        {
            fast=fast.next.next;
            prev=slow;
            slow=slow.next;
            
            if(fast==slow)
            {
                while(temp!=slow)
                {
                    temp=temp.next;
                    prev=slow;
                    slow=slow.next;
                }
                prev.next=null;
                return;
            }
        }
    }
}
