

public class Solution
{
    public static Node sortList(Node head) {
        // Write your code here

        Node zeroHead=new Node(-1);
        Node zero=zeroHead;
        Node oneHead=new Node(-1);
        Node one=oneHead;
        Node twoHead=new Node(-1);
        Node two=twoHead;

        Node temp=head;
        while(temp!=null)
        {
            if(temp.data==0)
            {
                zero.next=temp;
                zero=zero.next;
            }
            else if(temp.data==1)
            {
                one.next=temp;
                one=one.next;   
            }
            else{
                two.next=temp;
                two=two.next;
            }
            temp=temp.next;
        }
        two.next=null;
        one.next=twoHead.next;
        zero.next=oneHead.next;
        

       return zeroHead.next;
    }
}
