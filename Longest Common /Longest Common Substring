class Solution {
    public int longestCommonSubstr(String s1, String s2) {
        // code here
        int n=s1.length();
        int m=s2.length();
        int [][]t=new int[n+1][m+1];
        int maxLen=0;
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<m;j++)
            {
                if(i==0)
                {
                    t[i][0]=0;
                }
                if(j==0)
                {
                    t[0][j]=0;
                }
            }
        }
            
            for(int i=1;i<=n;i++)
            {
                for(int j=1;j<=m;j++)
                {
                    if(s1.charAt(i-1)==s2.charAt(j-1))
                    {
                        t[i][j]=1+t[i-1][j-1];
                        maxLen=Math.max(maxLen,t[i][j]);
                    }
                    else
                    {
                        t[i][j]=0;
                    }
                }
            }
            return maxLen;
        
    }
}
