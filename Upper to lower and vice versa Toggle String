class Main {
    public static void main(String[] args) {
        String s="Manya Gupta#@";
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<s.length();i++)
        {
            char ch=s.charAt(i);
            if(ch>='a' && ch<='z')
            {
                sb.append((char)(ch-32));
            }
            
            
            
            else if(ch>='A' && ch<='Z')
            {
                sb.append((char)(ch+32));
            }
            else
            {
                sb.append(ch);
            }
        }
        System.out.println(new String(sb));
    }
}
