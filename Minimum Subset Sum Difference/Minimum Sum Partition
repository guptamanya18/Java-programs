class Solution {

    public int minDifference(int arr[]) {
        // Your code goes here
        int n=arr.length;
        int sum=0;
        for(int i=0;i<n;i++)
        {
            sum+=arr[i];
        }
        
        int min=Integer.MAX_VALUE;
        for(int s1=0;s1<=sum/2;s1++)
        {
            if(subset(arr,s1))
            {
                int s2=sum-s1;
                min=Math.min(min,Math.abs(s2-s1));
            }
        }
        return min;
        
    }
    
    public boolean subset(int[]arr,int sum)
    {
        int n=arr.length;
        boolean[][]t=new boolean[n+1][sum+1];
        for(int i=0;i<n+1;i++)
        {
            for(int j=0;j<sum+1;j++)
            {
                if(i==0)
                {
                    t[i][j]=false;
                }
                if(j==0)
                {
                    t[i][j]=true;
                }
            }
        }
        
        for(int i=1;i<n+1;i++)
        {
            for(int j=1;j<sum+1;j++)
            {
                if(arr[i-1]<=j)
                {
                    t[i][j]=t[i-1][j-arr[i-1]]||t[i-1][j];
                }
                else
                {
                    t[i][j]=t[i-1][j];
                }
            }
        }
        
        return t[n][sum];
    }
}
