class Solution {
    static char nonRepeatingChar(String s) {
        // code here
        Map<Character,Integer>mp=new LinkedHashMap<>();
        for(int i=0;i<s.length();i++)
        {
            char ch=s.charAt(i);
            if(mp.containsKey(ch))
            {
                mp.put(ch,mp.get(ch)+1);
            }
            else
            {
                mp.put(ch,1);
            }
        }
        
        for(Map.Entry<Character,Integer>e:mp.entrySet())
        {
            if(e.getValue()==1)
            {
                return e.getKey();
            }
        }
        return '$';
    }
}
