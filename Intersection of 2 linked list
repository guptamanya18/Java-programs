/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {
        int len1=size(headA);
        int len2=size(headB);
        int diff=Math.abs(len1-len2);
        ListNode temp1=headA;
        ListNode temp2=headB;
        if(len1>len2)
        {
            while(diff!=0)
            {
                temp1=temp1.next;
                diff--;
            }
        }
        else
        {
            while(diff!=0)
            {
                temp2=temp2.next;
                diff--;
            }
        }
        while(temp1!=temp2)
        {
            temp1=temp1.next;
            temp2=temp2.next;
        }
        return temp1;
    }
    public int size(ListNode head)
    {
        ListNode temp=head;
        int s=0;
        while(temp!=null)
        {
            s++;
            temp=temp.next;
        }
        return s;
    }
}
