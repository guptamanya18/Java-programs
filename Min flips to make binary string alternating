lass Solution {
    public int minFlips(String S) {
        // Code here
        int cnt1=0;
        int cnt2=0;
        for(int i=0;i<S.length();i++)
        {
            char ch=S.charAt(i);
            if(i%2!=0 && ch=='0')
            {
                cnt1++;
            }
            else if(i%2==0 && ch=='1')
            {
                cnt1++;
            }
            else if(i%2!=0 && ch=='1')
            {
                cnt2++;
            }
            else if(i%2==0 && ch=='0')
            {
                cnt2++;
            }
        }
        return Math.min(cnt1,cnt2);
        
    }
}
