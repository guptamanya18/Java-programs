class Solution {
    public int longestConsecutive(int[] nums) {
        if(nums.length==1)
        {
            return 1;
        }
        Arrays.sort(nums);
        Set<Integer>set=new TreeSet<>();
        for(int num:nums)
        {
            set.add(num);

        }

        int[]temp=new int[set.size()];
        int index=0;
        for(int num:set)
        {
            temp[index++]=num;
        }
        if(temp.length==1)
        {
            return 1;
        }
         
         int ans=0;
         int count=1;
        for(int i=0;i<temp.length-1;i++){
            if(temp[i+1]==temp[i]+1)
            {
                count++;
            }
            else
            {
                count=1;
            }
            ans=Math.max(ans,count);
        }
        return ans;
    }
}
