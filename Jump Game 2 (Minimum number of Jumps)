class Solution {
    static int minJumps(int[] arr) {
        // code here
        if(arr.length<=1)
        {
            return 0;
        }
        if(arr[0]==0){
            return -1;
        }
        int cnt=0;
        int src=0;
        int des=0;
        for(int i=0;i<arr.length;i++)
        {
            des=Math.max(des,i+arr[i]);
            if(i==src){
               if(i==des)
               {
                cnt=-1;
                break;
                }
            
                src=des;
                cnt++;
            
                if(des>=arr.length-1)
                {
                break;
                }
            }
        }
        return cnt;
    }
}
