class Solution {
    public static Node reverseKGroup(Node head, int k) {
        // code here
        Node prevHead=null;
        Node currHead=head;
        Node ans=null;
        
        while(currHead!=null)
        {
            Node prev=null;
            Node curr=currHead;
            int j=0;
            while(j<k && curr!=null){
            Node next=curr.next;
            curr.next=prev;
            prev=curr;
            curr=next;
            j++;
            } 
            if(prevHead==null)
            {
                ans=prev;
            }
            else
            {
                prevHead.next=prev;
            }
            
            prevHead=currHead;
            currHead=curr;
        }
        return ans;
    }
}
