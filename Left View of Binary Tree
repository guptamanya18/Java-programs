/* A Binary Tree node
class Node
{
    int data;
    Node left, right;

    Node(int item)
    {
        data = item;
        left = right = null;
    }
}*/
class Solution {
    // Function to return list containing elements of left view of binary tree.
    ArrayList<Integer> leftView(Node root) {
        // code here
        ArrayList<Integer>res=new ArrayList<>();
        if(root==null)
        {
            return res;
        }
        
        Queue<Node>qu=new LinkedList<>();
        qu.add(root);
        
        
         while(!qu.isEmpty())
        {
            int size=qu.size();
        if(size>0)
        {
            Node node=qu.peek();
            res.add(node.data);
        }
        while(size>0){
            Node node=qu.poll();
            if(node.left!=null)
            {
                qu.add(node.left);
            }
            if(node.right!=null)
            {
                qu.add(node.right);
            }
            
            size--;
        }
        }
    
        
        return res;
    }
}
