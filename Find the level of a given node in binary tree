class Solution {
    /* Returns level of given data value */
    int getLevel(Node node, int data) {
        List<Integer>l=new ArrayList<>();
        int levels=level(node);
        // Write your code here
        for(int i=1;i<=levels;i++)
        {
           nthlevel(node,i,l);
           if(l.contains(data))
           {
               return i;
           }
        }
        return 0;
        
    }
    void nthlevel(Node node,int n,List<Integer>list)
    {
        if(node==null)
        {
            return;
        }
        if(n==1)
        {
            list.add(node.data);
        }
        nthlevel(node.left,n-1,list);
        nthlevel(node.right,n-1,list);
    }
    int height(Node node)
    {
        if(node==null)
        {
            return -1;
            
        }
        
        int lh=height(node.left);
        int rh=height(node.right);
        int ans=Math.max(lh,rh)+1;
        return ans;
    }
    int level(Node node)
    {
        int ans=height(node)+1;
        return ans;
    }
}
