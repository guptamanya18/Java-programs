class Solution {
    // Function to return a list of nodes visible from the top view
    // from left to right in Binary Tree.
    
    static class Custom{
        Node node;
        int col;
        Custom(Node node,int col)
        {
            this.node=node;
            this.col=col;
        }
    }
    static ArrayList<Integer> topView(Node root) {
        // code here
        ArrayList<Integer>res=new ArrayList<>();
        if(root==null)
        {
            return res;
        }
        Queue<Custom>qu=new LinkedList<>();
        qu.add(new Custom(root,0));
        
        Map<Integer,Integer>mp=new TreeMap<>();
        
        while(!qu.isEmpty())
        {
            Custom csnode=qu.poll();
            Node node=csnode.node;
            int col=csnode.col;
            
            if(!mp.containsKey(col))
            {
                mp.put(col,node.data);
            }
            
            if(node.left!=null)
            {
                qu.add(new Custom(node.left,col-1));
            }
            if(node.right!=null)
            {
                qu.add(new Custom(node.right,col+1));
            }
            
        }
        
        for(Map.Entry<Integer,Integer>e:mp.entrySet())
        {
            res.add(e.getValue());
        }
        
        return res;
        
    }
}
